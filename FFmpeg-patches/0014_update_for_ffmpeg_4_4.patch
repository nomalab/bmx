+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/fifo.h"
+#include "libavutil/mathematics.h"
+#include "libavutil/avassert.h"
+#include "avformat.h"
+#include "audiointerleave.h"
+#include "internal.h"
+
+// Déclaration explicite de la fonction interleave_new_audio_packet
+static int interleave_new_audio_packet(AVFormatContext *s, AVPacket *pkt,
+                                       int stream_index, int flush);
+
+extern int ff_interleave_add_packet(AVFormatContext *s, AVPacket *pkt,
+                        int (*compare_ts)(AVFormatContext *, const AVPacket *, const AVPacket *));
+
+void ff_audio_interleave_close(AVFormatContext *s)
+{
+    int i;
+    for (i = 0; i < s->nb_streams; i++) {
+        AVStream *st = s->streams[i];
+        AudioInterleaveContext *aic = st->priv_data;
+
+        if (aic && st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO)
+            av_fifo_freep2(&aic->fifo);
+    }
+}
+
+int ff_audio_interleave_init(AVFormatContext *s,
+                             const int samples_per_frame,
+                             AVRational time_base)
+{
+    int i;
+    int max_samples, channels, bits_per_sample;
+    AudioInterleaveContext *aic;
+    AVStream *st;
+
+    if (!time_base.num) {
+        av_log(s, AV_LOG_ERROR, "timebase not set for audio interleave\n");
+        return AVERROR(EINVAL);
+    }
+    for (i = 0; i < s->nb_streams; i++) {
+        st = s->streams[i];
+        aic = st->priv_data;
+
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) {
+            max_samples = samples_per_frame ? samples_per_frame :
+                          av_rescale_rnd(st->codecpar->sample_rate, time_base.num, time_base.den, AV_ROUND_UP);
+            channels = st->codecpar->ch_layout.nb_channels;
+            if (channels <= 0) {
+                av_log(s, AV_LOG_ERROR, "Invalid or missing channel layout\n");
+                return AVERROR(EINVAL);
+            }
+            bits_per_sample = av_get_bits_per_sample(st->codecpar->codec_id);
+            if (bits_per_sample <= 0) {
+                av_log(s, AV_LOG_ERROR, "Invalid bits per sample for codec\n");
+                return AVERROR(EINVAL);
+            }
+            aic->sample_size = (channels * bits_per_sample) / 8;
+            if (!aic->sample_size) {
+                av_log(s, AV_LOG_ERROR, "could not compute sample size\n");
+                return AVERROR(EINVAL);
+            }
+            aic->samples_per_frame = samples_per_frame;
+            aic->time_base = time_base;
+
+            if (!(aic->fifo = av_fifo_alloc2(max_samples, aic->sample_size, AV_FIFO_FLAG_AUTO_GROW)))
+                return AVERROR(ENOMEM);
+            aic->fifo_size = max_samples;
+        }
+    }
+
+    return 0;
+}
+
+int ff_audio_rechunk_interleave(AVFormatContext *s, AVPacket *pkt, int flush, int has_packet,
+                        int (*get_packet)(AVFormatContext *, AVPacket *, int),
+                        int (*compare_ts)(AVFormatContext *, const AVPacket *, const AVPacket *))
+{
+    int i, ret;
+
+    if (has_packet) {
+        AVStream *st = s->streams[pkt->stream_index];
+        AudioInterleaveContext *aic = st->priv_data;
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) {
+            if (av_fifo_write(aic->fifo, pkt->data, pkt->size) < 0)
+                return AVERROR(ENOMEM);
+        } else {
+            pkt->pts = pkt->dts = aic->dts;
+            aic->dts += pkt->duration;
+            if ((ret = get_packet(s, pkt, flush)) < 0)
+                return ret;
+        }
+    }
+
+    for (i = 0; i < s->nb_streams; i++) {
+        AVStream *st = s->streams[i];
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) {
+            AVPacket new_pkt = {0};
+            while ((ret = interleave_new_audio_packet(s, &new_pkt, i, flush)) > 0) {
+                if ((ret = ff_interleave_add_packet(s, &new_pkt, compare_ts)) < 0)
+                    return ret;
+            }
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return get_packet(s, pkt, flush);
+}
+
+static int interleave_new_audio_packet(AVFormatContext *s, AVPacket *pkt,
+                                       int stream_index, int flush)
+{
+    return 0;
+}
+
